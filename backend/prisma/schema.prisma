// Prisma Schema for Veya
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NOTE: Application models (User, Card, SocialLink, AnalyticsEvent, Subscription)
// will be defined here during future feature implementation phases.
