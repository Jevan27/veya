// Prisma Schema for Veya
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  passwordHash       String?  @map("password_hash")
  name                String?
  company             String?
  role                String?
  avatarUrl           String?  @map("avatar_url")
  phoneNumber         String?  @map("phone_number")
  onboardingCompleted Boolean  @default(false) @map("onboarding_completed")
  hashedRefreshToken  String?  @map("hashed_refresh_token")
  provider           String?  @default("email")
  providerId         String?  @map("provider_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  cards              BusinessCard[]

  @@map("users")
}

model BusinessCard {
  id                  String   @id @default(uuid())
  userId              String   @map("user_id")
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  role                String?
  company             String?
  slogan              String?
  phoneNumber         String?  @map("phone_number")
  email               String?
  location            String?
  website             String?
  avatarUrl           String?  @map("avatar_url")
  companyLogoUrl      String?  @map("company_logo_url")
  primaryColor        String?  @default("#111111") @map("primary_color")
  cardBackgroundColor String?  @default("#FFFFFF") @map("card_background_color")
  isDefault           Boolean  @default(false) @map("is_default")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("business_cards")
}

